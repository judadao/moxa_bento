{
  "manifest_version": 3,
  "name": "便當小夜班・訂餐同步",
  "version": "0.2.0",
  "description": "沿用目前瀏覽器的 Moxa 訂餐登入，把午餐預約同步到本機桌面精靈。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://foodcourt.moxa.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://foodcourt.moxa.com/foodCourt/staff/home*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
